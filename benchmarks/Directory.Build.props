<Project>
  <!-- BenchmarkDotNet generates its boilerplate project under bin/, where it would
       inherit the repo-wide TargetFrameworks and fail restore on net8.0/net10.0. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>
</Project>
