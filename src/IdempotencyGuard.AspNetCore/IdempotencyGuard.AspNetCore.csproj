<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>IdempotencyGuard.AspNetCore</PackageId>
    <Description>Idempotency-Key middleware for ASP.NET Core. Stops retries and concurrent duplicates from running a request twice, with request fingerprinting, response replay and per-endpoint configuration for controllers and minimal APIs.</Description>
    <PackageTags>idempotency;idempotent;idempotency-key;aspnetcore;minimal-api;middleware;api;http;deduplication;retry;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdempotencyGuard\IdempotencyGuard.csproj" />
  </ItemGroup>

</Project>
